<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Midnight Garage</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSUserTrackingUsageDescription</key>
	<string>Midnight Garage uses this to show ads that are more relevant to you. Declining keeps ads non-personalized — nothing else changes.</string>
	<!-- Google's well-known public TEST App ID (pairs with the test ad unit
	     IDs already in js/ads.js's AD_UNIT_IDS, both gated behind
	     AD_TEST_MODE = true there). Deliberately NOT a placeholder string:
	     the Google Mobile Ads SDK validates this key's format at init and
	     will crash on first native launch if it's missing or malformed, so
	     a real (if test-mode) value is safer to ship than a `[FILL IN]`
	     bracket. Swap for this app's real AdMob App ID — and flip
	     AD_TEST_MODE to false in js/ads.js at the same time — once a real
	     AdMob account exists. See STORE-SHIP-PLAN.md P0-11. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<!-- Google's own SKAdNetwork ID — required for AdMob attribution
	     regardless of which mediated networks are active. The dozens of
	     additional third-party-buyer IDs Google recommends are NOT
	     included here on purpose: that list changes over time and Google
	     explicitly publishes it as a living page rather than a fixed set,
	     so a hardcoded snapshot risks going stale silently. Pull the
	     current full list from
	     https://developers.google.com/admob/ios/ios14 (search
	     "SKAdNetworkItems") and add each additional
	     SKAdNetworkIdentifier as its own dict entry in this array before
	     shipping — this is a monetization-completeness gap if skipped,
	     not a crash risk like GADApplicationIdentifier above. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
</dict>
</plist>
