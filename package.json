{
  "name": "midnight-garage",
  "version": "1.0.0",
  "description": "Midnight Garage — a premium-feel car escape puzzle. Free the red car.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node tools/serve.mjs",
    "generate": "node tools/generate-levels.mjs",
    "verify": "node tools/verify-levels.mjs",
    "build": "node tools/build-www.mjs",
    "build:release": "node tools/build-www.mjs --release",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:release": "npm run build:release && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.0.0"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0"
  }
}
